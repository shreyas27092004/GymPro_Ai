# =============================================================================
# GymPro AI - Environment Configuration (.env.example)
# Copy to .env and configure for your environment. Never commit real .env files!
# =============================================================================

# Application Environment (development | production)
ENV=development

# -----------------------------------------------------------------------------
# Database URLs (PostgreSQL 15+)
# -----------------------------------------------------------------------------
# App runtime connection (least privilege, RLS enforced)
DATABASE_URL=postgresql+asyncpg://gympro_app:change-me@localhost:5432/gympro
TEST_DATABASE_URL=postgresql+asyncpg://gympro_app:change-me@localhost:5432/gympro_test

# Seed connection (used by seed_admin and dev fixtures)
SEED_DATABASE_URL=postgresql+asyncpg://gympro_seed:change-me@localhost:5432/gympro
TEST_SEED_DATABASE_URL=postgresql+asyncpg://gympro_seed:change-me@localhost:5432/gympro_test

# Analytics connection (read-only views, used by ADMIN_INSIGHTS)
ANALYTICS_DATABASE_URL=postgresql+asyncpg://gympro_analytics:change-me@localhost:5432/gympro

# Superuser connection (used solely by pytest harness to manage test fixtures)
SUPERUSER_DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/gympro_test

# -----------------------------------------------------------------------------
# Cryptographic Keys (RS256 JWT & Token HMAC)
# Generated automatically per machine via: python scripts/gen_keys.py
# Multi-line PEM keys are stored on a single line with escaped \n
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nchange-me\n-----END PUBLIC KEY-----"
TOKEN_HMAC_SECRET=change-me

# Frontend Application Origin (CORS & email link generation)
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Message Broker (RabbitMQ 3.12+)
# -----------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# -----------------------------------------------------------------------------
# Email / SMTP Configuration (Mailpit or Dev SMTP Sink)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="GymPro <no-reply@gympro.local>"
# Optional custom binary path for Mailpit executable:
# MAILPIT_PATH=C:\tools\mailpit\mailpit.exe

# -----------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------
# mock: instant simulated payments (local dev / keyless demos; refused in production)
# razorpay: requires test or live key credentials
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

# -----------------------------------------------------------------------------
# Vector Store (ChromaDB)
# -----------------------------------------------------------------------------
CHROMA_PATH=./gympro_vector_store

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# IMPORTANT COMPANY PC RULE: Ollama is NOT allowed on company PCs.
# Use `fake` for local dev/testing without external calls, or company-approved Azure.
# `fake` is strictly refused when ENV=production.
# -----------------------------------------------------------------------------
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o
LLM_API_KEY=fake

# Option B: Company-Approved Azure OpenAI Endpoint
# LLM_PROVIDER=azure
# AZURE_ENDPOINT=https://your-company-resource.openai.azure.com/
# LLM_API_KEY=your-approved-azure-key
# LLM_MODEL=your-deployment-name
# AZURE_API_VERSION=2024-10-21

# Option C: Direct OpenAI (if approved)
# LLM_PROVIDER=openai
# LLM_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4o
